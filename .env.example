# Supabase (선택) — 비워두면 로그인 없이 로컬 전용 모드로 동작합니다.
# 값 얻는 방법: docs/SUPABASE_SETUP.md 참고
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 웹 푸시 알림(단계 1-a) — VAPID 공개키.
# 앱 번들에 들어가는 값이라 공개돼도 됩니다. **비밀키는 여기 넣지 마세요** —
# 비밀키는 서버 발송(2단계)에서 Supabase 쪽 비밀값으로만 씁니다.
# 만드는 법: docs/NOTIFICATIONS.md §6-1 참고
VITE_VAPID_PUBLIC_KEY=
